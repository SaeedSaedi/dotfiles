{
  // ── EDITOR CORE ──────────────────────────────────────────────────────────────
  "editor.fontFamily": "'JetBrains Mono', 'Fira Code', 'Cascadia Code', Menlo, monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 14,
  "editor.lineHeight": 1.6,
  "editor.letterSpacing": 0.3,
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.detectIndentation": true,
  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,
  "editor.wordWrap": "off",
  "editor.minimap.enabled": false,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.guides.indentation": true,
  "editor.renderWhitespace": "trailing",
  "editor.stickyScroll.enabled": true,
  "editor.inlayHints.enabled": "on",
  "editor.linkedEditing": true,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.suggestSelection": "first",
  "editor.acceptSuggestionOnCommitCharacter": false,
  "editor.quickSuggestionsDelay": 100,
  "editor.rulers": [88, 120],
  "editor.inlineSuggest.suppressSuggestions": false,

  // ── WORKBENCH ────────────────────────────────────────────────────────────────
  "workbench.colorTheme": "One Dark Pro",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.colorCustomizations": {
    "[One Dark Pro]": {
      "terminal.background": "#21252b",
      "terminal.foreground": "#abb2bf",
      "editor.background": "#21252b",
      "editorGroupHeader.tabsBackground": "#181a1f",
      "activityBar.background": "#181a1f",
      "sideBar.background": "#1e2127",
      "statusBar.background": "#181a1f",
      "titleBar.activeBackground": "#181a1f",
      "tab.inactiveBackground": "#21252b",
      "tab.activeBackground": "#282c34"
    }
  },
  "workbench.startupEditor": "none",
  "workbench.tree.indent": 16,
  "workbench.editor.labelFormat": "short",
  "workbench.editor.tabSizing": "shrink",
  "workbench.editor.wrapTabs": true,
  "workbench.sideBar.location": "left",
  "workbench.statusBar.visible": true,
  "workbench.layoutControl.enabled": false,
  "breadcrumbs.enabled": true,

  // ── FILES ────────────────────────────────────────────────────────────────────
  "files.autoSave": "onFocusChange",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.saveConflictResolution": "overwriteFileOnDisk",
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/vendor": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/vendor/**": true,
    "**/__pycache__/**": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/vendor": true,
    "**/__pycache__": true,
    "**/.git": true
  },

  // ── PYTHON ───────────────────────────────────────────────────────────────────
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.rulers": [88],
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.fixAll": "explicit"
    }
  },
  "python.analysis.typeCheckingMode": "standard",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.inlayHints.functionReturnTypes": true,
  "python.analysis.inlayHints.variableTypes": false,
  "python.analysis.inlayHints.pytestParameters": true,
  "python.analysis.diagnosticMode": "workspace",
  "black-formatter.args": ["--line-length=88"],
  "debugpy.debugJustMyCode": false,

  // ── PHP / LARAVEL ─────────────────────────────────────────────────────────────
  "[php]": {
    "editor.defaultFormatter": "bmewburn.vscode-intelephense-client",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.rulers": [120]
  },
  "[blade]": {
    "editor.defaultFormatter": "shufo.vscode-blade-formatter",
    "editor.formatOnSave": true,
    "editor.tabSize": 4
  },
  "intelephense.environment.phpVersion": "8.2",
  "intelephense.files.maxSize": 5000000,
  "intelephense.telemetry.enabled": false,
  "intelephense.diagnostics.undefinedClassConstants": true,
  "intelephense.diagnostics.undefinedMethods": true,
  "intelephense.format.enable": true,
  "bladeFormatter.format.indentSize": 4,
  "bladeFormatter.format.wrapLineLength": 120,
  "bladeFormatter.format.sortTailwindcssClasses": false,
  "emmet.includeLanguages": {
    "blade": "html",
    "django-html": "html"
  },

  // ── GO ───────────────────────────────────────────────────────────────────────
  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.formatOnSave": true,
    "editor.insertSpaces": false,
    "editor.tabSize": 4,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "go.toolsManagement.autoUpdate": true,
  "go.lintTool": "golangci-lint",
  "go.lintOnSave": "package",
  "go.vetOnSave": "package",
  "go.useLanguageServer": true,
  "gopls": {
    "ui.semanticTokens": true,
    "ui.inlayhints.assignVariableTypes": true,
    "ui.inlayhints.compositeLiteralFields": true,
    "ui.inlayhints.functionTypeParameters": true,
    "ui.inlayhints.parameterNames": true,
    "ui.inlayhints.rangeVariableTypes": true
  },

  // ── JAVASCRIPT / TYPESCRIPT / NODE ───────────────────────────────────────────
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.tabSize": 2
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[django-html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "eslint.run": "onSave",

  // ── GIT ──────────────────────────────────────────────────────────────────────
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.postCommitCommand": "none",
  "diffEditor.ignoreTrimWhitespace": false,
  "gitlens.currentLine.enabled": true,
  "gitlens.hovers.currentLine.over": "line",

  // ── TERMINAL ─────────────────────────────────────────────────────────────────
  "terminal.integrated.fontFamily": "'JetBrains Mono', 'JetBrainsMono Nerd Font', Menlo, monospace",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.lineHeight": 1.3,
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.inheritEnv": true,

  // ── EXPLORER ─────────────────────────────────────────────────────────────────
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.compactFolders": false,
  "explorer.sortOrder": "type",

  // ── GITHUB COPILOT ────────────────────────────────────────────────────────────
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true,
    "scminput": false
  },

  // ── SPELL CHECK ──────────────────────────────────────────────────────────────
  "cSpell.userWords": [
    "aiocache", "asgiref", "certifi", "coreapi", "coreschema",
    "djangorestframework", "hashpw", "idna", "itypes", "jsonschema",
    "rpds", "Saeed", "sqlparse", "uritemplate", "urllib"
  ],

  // ── INDENT RAINBOW ───────────────────────────────────────────────────────────
  "indentRainbow.colors": [
    "rgba(99,132,227,0.1)",
    "rgba(224,108,117,0.1)",
    "rgba(152,195,121,0.1)",
    "rgba(229,192,123,0.1)"
  ],
  "indentRainbow.excludedLanguages": ["plaintext"],

  // ── REST CLIENT ──────────────────────────────────────────────────────────────
  "rest-client.previewOption": "exchange",
  "rest-client.timeoutinmilliseconds": 30000,

  // ── TODO TREE ────────────────────────────────────────────────────────────────
  "todo-tree.general.tags": ["TODO", "FIXME", "HACK", "BUG", "NOTE", "XXX"],
  "todo-tree.highlights.defaultHighlight": {
    "type": "text"
  },

  // ── MISC ─────────────────────────────────────────────────────────────────────
  "telemetry.telemetryLevel": "off",
  "redhat.telemetry.enabled": false,
  "security.workspace.trust.untrustedFiles": "open",
  "claudeCode.preferredLocation": "panel"
}
