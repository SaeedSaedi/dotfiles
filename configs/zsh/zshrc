# ════════════════════════════════════════════════════════════════════════════
#  .zshrc — cross-platform (macOS + Linux)
# ════════════════════════════════════════════════════════════════════════════

# ── Resolve dotfiles repo location ───────────────────────────────────────────
# ~/.zshrc is a symlink into the repo; walk back up to find the root.
# Falls back gracefully if not installed via symlink (e.g. sourced directly).
if [[ -z "${DOTFILES:-}" && -L "$HOME/.zshrc" ]]; then
    _zshrc_src="$(readlink "$HOME/.zshrc")"              # .../dotfiles/configs/zsh/zshrc
    DOTFILES="$(cd "$(dirname "$_zshrc_src")/../.." && pwd)"
    export DOTFILES
    unset _zshrc_src
fi

# ── OS detection & Homebrew ──────────────────────────────────────────────────
if [[ "$OSTYPE" == "darwin"* ]]; then
    IS_MACOS=true
    if [[ -f /opt/homebrew/bin/brew ]]; then        # Apple Silicon
        eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [[ -f /usr/local/bin/brew ]]; then          # Intel
        eval "$(/usr/local/bin/brew shellenv)"
    fi
    BREW_PREFIX="${HOMEBREW_PREFIX:-/opt/homebrew}"
else
    IS_MACOS=false
    BREW_PREFIX=""
    # User-local bin: zoxide, atuin, claude, npm globals, etc.
    export PATH="$HOME/.local/bin:$HOME/.npm-global/bin:$PATH"
    export PATH="/usr/local/go/bin:$HOME/go/bin:$PATH"
fi

# ── Oh My Zsh ────────────────────────────────────────────────────────────────
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"

# ── History ──────────────────────────────────────────────────────────────────
HISTSIZE=100000
SAVEHIST=100000
HISTFILE=~/.zsh_history
setopt HIST_IGNORE_ALL_DUPS HIST_FIND_NO_DUPS HIST_REDUCE_BLANKS
setopt SHARE_HISTORY HIST_VERIFY

# ── Completion ───────────────────────────────────────────────────────────────
setopt AUTO_MENU COMPLETE_IN_WORD ALWAYS_TO_END
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'

# ── zsh-autosuggestions config (must be set before OMZ / plugin source) ──────
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#6c7086"   # Catppuccin Overlay0

# On Linux: auto-clone plugins if missing so the zshrc is self-healing
if ! $IS_MACOS && [[ -d "$HOME/.oh-my-zsh" ]]; then
    _zsh_custom="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins"
    [[ ! -d "$_zsh_custom/zsh-autosuggestions" ]] && \
        git clone --depth=1 https://github.com/zsh-users/zsh-autosuggestions \
            "$_zsh_custom/zsh-autosuggestions" 2>/dev/null
    [[ ! -d "$_zsh_custom/zsh-syntax-highlighting" ]] && \
        git clone --depth=1 https://github.com/zsh-users/zsh-syntax-highlighting \
            "$_zsh_custom/zsh-syntax-highlighting" 2>/dev/null
    unset _zsh_custom
fi

# ── Plugins ──────────────────────────────────────────────────────────────────
plugins=(
    git
    python
    pip
    virtualenv
    docker
    command-not-found
)
$IS_MACOS && plugins+=(macos)

source "$ZSH/oh-my-zsh.sh"

# ── Editor ───────────────────────────────────────────────────────────────────
export EDITOR='nvim'
export VISUAL='nvim'

# ── zsh-autosuggestions ──────────────────────────────────────────────────────
# macOS: source from Homebrew (not in ZSH_CUSTOM so OMZ won't find it)
# Linux: source from custom plugins (auto-cloned above if missing)
if [[ -n "$BREW_PREFIX" && -f "$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
    source "$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
elif [[ -f "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
    source "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi
bindkey '^ ' autosuggest-accept    # Ctrl+Space accepts

# ── zsh-syntax-highlighting (must be sourced last) ────────────────────────────
if [[ -n "$BREW_PREFIX" && -f "$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
    source "$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
elif [[ -f "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
    source "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

# ── fzf ──────────────────────────────────────────────────────────────────────
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_DEFAULT_OPTS='
  --height 50% --layout=reverse --border rounded
  --color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8
  --color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc
  --color=marker:#f5e0dc,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8
  --preview "bat --color=always --style=numbers --line-range=:50 {}"
  --preview-window=right:50%:wrap
'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_CTRL_T_OPTS='--preview "bat --color=always --style=numbers {}"'
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
export FZF_ALT_C_OPTS='--preview "eza --tree --level=2 --icons --color=always {}"'
export FZF_CTRL_R_OPTS='--preview "" --no-preview'

# Source fzf shell integration (key bindings + completion) directly — more
# reliable than the OMZ fzf plugin which has different path expectations per OS.
if $IS_MACOS && [[ -n "$BREW_PREFIX" ]]; then
    [[ -f "$BREW_PREFIX/opt/fzf/shell/key-bindings.zsh" ]] && \
        source "$BREW_PREFIX/opt/fzf/shell/key-bindings.zsh"
    [[ -f "$BREW_PREFIX/opt/fzf/shell/completion.zsh" ]] && \
        source "$BREW_PREFIX/opt/fzf/shell/completion.zsh"
else
    # apt installs fzf shell files here; also check ~/.fzf (manual install)
    [[ -f /usr/share/doc/fzf/examples/key-bindings.zsh ]] && \
        source /usr/share/doc/fzf/examples/key-bindings.zsh
    [[ -f /usr/share/doc/fzf/examples/completion.zsh ]] && \
        source /usr/share/doc/fzf/examples/completion.zsh
    [[ -f ~/.fzf.zsh ]] && source ~/.fzf.zsh
fi

# ── bat ──────────────────────────────────────────────────────────────────────
export BAT_THEME="Catppuccin Mocha"
export MANPAGER="sh -c 'col -bx | bat -l man -p'"
export MANROFFOPT="-c"

# ── zoxide (smart cd) ────────────────────────────────────────────────────────
if command -v zoxide &>/dev/null; then
    eval "$(zoxide init zsh --cmd cd)"
fi

# ── atuin (better history Ctrl+R) ────────────────────────────────────────────
if command -v atuin &>/dev/null; then
    eval "$(atuin init zsh --disable-up-arrow)"
fi

# ── eza (modern ls) ──────────────────────────────────────────────────────────
alias ls='eza --icons --group-directories-first'
alias la='eza -a --icons --group-directories-first'
alias ll='eza -lah --icons --group-directories-first --git --time-style=relative'
alias lt='eza --tree --icons --level=2 --group-directories-first'
alias lta='eza --tree --icons --level=3 --all --ignore-glob=".git|node_modules|.venv"'

# ── Navigation ───────────────────────────────────────────────────────────────
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias ~='cd ~'

# ── Python dev ───────────────────────────────────────────────────────────────
alias py='python3'
alias venv='python3 -m venv .venv'
alias va='source .venv/bin/activate'
alias vd='deactivate'
alias pipi='pip install'
alias pipr='pip install -r requirements.txt'
alias pipf='pip freeze > requirements.txt'

# ── Git shortcuts ────────────────────────────────────────────────────────────
alias gl='git log --oneline --graph --decorate --all'
alias gla='git log --all --graph --pretty=format:"%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset"'
alias lg='lazygit'
alias gdt='git diff | delta'

# ── Utilities ────────────────────────────────────────────────────────────────
alias cat='bat'
alias vi='nvim'
alias vim='nvim'
alias reload='source ~/.zshrc && echo "zshrc reloaded"'
alias zshconfig='$EDITOR ~/.zshrc'
alias ip='curl -s ifconfig.me && echo'
alias ports='lsof -i -P -n | grep LISTEN 2>/dev/null || netstat -tulanp 2>/dev/null'
alias jqp='jq .'
alias jql='jq -r .[]'

# ── PATH ─────────────────────────────────────────────────────────────────────
# macOS: Linux already includes ~/.local/bin in the OS block at the top
$IS_MACOS && export PATH="$HOME/.local/bin:$PATH"

# ── pyenv ────────────────────────────────────────────────────────────────────
if [[ -d "$HOME/.pyenv" ]]; then
    export PYENV_ROOT="$HOME/.pyenv"
    export PATH="$PYENV_ROOT/bin:$PATH"
    eval "$(pyenv init -)"
fi

# ── direnv ───────────────────────────────────────────────────────────────────
if command -v direnv &>/dev/null; then
    eval "$(direnv hook zsh)"
fi

# ── macOS-only extras ────────────────────────────────────────────────────────
if $IS_MACOS; then
    alias genpass='pwgen -n -c -C -B 16 8'
fi

# ── dotfiles management ──────────────────────────────────────────────────────
dotfiles() {
    local df="${DOTFILES:-$HOME/dotfiles}"
    case "${1:-}" in
        update)  "$df/install.sh" update ;;
        check)   "$df/test.sh" ;;
        edit)    ${EDITOR:-nvim} "$df" ;;
        cd)      cd "$df" ;;
        *)
            echo "Usage: dotfiles <command>"
            echo "  update   pull latest + sync plugins + re-link configs"
            echo "  check    run health checks"
            echo "  edit     open repo in \$EDITOR"
            echo "  cd       cd into repo"
            ;;
    esac
}

# ── Local overrides (machine-specific config, never committed) ────────────────
# Copy configs/zsh/zshrc.local.example → ~/.zshrc.local to add proxy helpers,
# machine-specific aliases, JetBrains hooks, etc.
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
